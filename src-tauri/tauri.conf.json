{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StatsCitizen",
  "version": "2.2.0",
  "identifier": "com.statscitizen.terminal",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StatsCitizen // Fleet & Live Telemetry Terminal",
        "width": 1380,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#05080f",
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
